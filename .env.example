# Copy to .env.local for development. In production these live in Vercel.
# The names match the existing Vercel project (the old Vite site), so nothing
# needs to be renamed there.

# Supabase (leads). Same project the old site used. The public anon key is
# enough because the old site inserted with it; SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY take priority if you set them (server only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Meta Conversions API (server only, secret).
META_ACCESS_TOKEN=
VITE_META_PIXEL_ID=
# META_TEST_EVENT_CODE=TEST12345

# Optional overrides. Defaults are the IDs already public on texhco.com.
# NEXT_PUBLIC_GA_ID=G-GF2P833R0D
# NEXT_PUBLIC_META_PIXEL_ID=

# Emails are not sent from this app: inserting a lead fires the existing
# Supabase Database Webhook -> send-lead-email Edge Function -> Resend.
# RESEND_API_KEY lives in Supabase (secrets), not here.
